# ==============================================================================
# KONFIGURASI SISTEM LIBNAV UNSIKA
# ==============================================================================

PORT=3000

# 1. KREDENSIAL LOGIN ADMIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminunsika

# 2. KONEKSI DATABASE NEON POSTGRESQL CLOUD
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# 3. KONEKSI BROKER MQTT (HIVEMQ CLOUD / PUBLIC BROKER)
MQTT_BROKER_URL=mqtt://broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=libnav/unsika/rak/led

# 4. DURASI ANIMASI LAMPU LED DI RAK (Detik)
LED_ANIMATION_DURATION=15

# 5. INTEGRASI CLOUDINARY MEDIA STORAGE
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
